# =============================================================
# Pixio Theme — .gitignore
# =============================================================
# Note: This is a static HTML theme. No build step.
# All vendor/, dist/, and src/ folders under vendor/ ARE committed.

# ---------- OS junk ----------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.Trash-*

# ---------- Editors / IDEs ----------
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.swn
*.sublime-project
*.sublime-workspace
.project
.classpath
nbproject/

# ---------- Logs ----------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Environment / secrets ----------
.env
.env.*
!.env.example

# ---------- Build artifacts (NOT vendor dist/ — that's part of the theme) ----------
# If you ever add a build step at project root, uncomment:
# /node_modules/
# /build/
# /dist/        # root-level only — vendor/*/dist/ is committed
.cache/
.parcel-cache/
.tmp/
/tmp/
*.tsbuildinfo

# ---------- Python (if you use http.server scripts) ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/

# ---------- Backups ----------
*.bak
*.backup
*.old
*.orig
*.rej

# ---------- Local-only dev files ----------
/local/
/dev/
*.local.html
*.local.css
*.local.js

# ---------- Misc ----------
*.zip
*.tar.gz
*.tgz
*.rar
.DS_Store?
profile
Thumbs.db
